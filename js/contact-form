
$(document).ready(function () {

    // Fill contact form after successful registration
    const params = new URLSearchParams(window.location.search);

    if (params.get("registered") === "true") {
        $("#registrationSuccessAlert").removeClass("d-none");

        $("#username").val(params.get("name") || "");
        $("#email").val(params.get("email") || "");
    }

    // TASK 5: Contact Form Validation
    $("#contactForm").on("submit", function (event) {
        event.preventDefault();

        const name = $("#username").val().trim();
        const email = $("#email").val().trim();
        const message = $("#comment").val().trim();

        let isValid = true;

        // Name validation
        if (name.length < 2) {
            $("#username")
                .removeClass("is-valid")
                .addClass("is-invalid");

            $("#name-feedback").text(
                "Please enter your name (minimum 2 characters)."
            );

            isValid = false;
        } else {
            $("#username")
                .removeClass("is-invalid")
                .addClass("is-valid");
        }

        // Email validation
        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

        if (!emailPattern.test(email)) {
            $("#email")
                .removeClass("is-valid")
                .addClass("is-invalid");

            $("#email-feedback").text(
                "Please provide a valid email address."
            );

            isValid = false;
        } else {
            $("#email")
                .removeClass("is-invalid")
                .addClass("is-valid");
        }

        // Message validation
        if (message.length < 10 || message.length > 500) {
            $("#comment")
                .removeClass("is-valid")
                .addClass("is-invalid");

            $("#message-feedback").text(
                "Message must be between 10 and 500 characters."
            );

            isValid = false;
        } else {
            $("#comment")
                .removeClass("is-invalid")
                .addClass("is-valid");
        }

        // Final feedback
        if (isValid) {
            $("#contactFeedback")
                .removeClass("text-danger")
                .addClass("text-success")
                .text(
                    "Your form has been validated successfully! " +
                    "This is a demo. Your information was not sent or stored."
                );
        } else {
            $("#contactFeedback")
                .removeClass("text-success")
                .addClass("text-danger")
                .text("Please correct the highlighted fields.");
        }

    });

    // Clear the previous status when the user edits a field
    $("#contactForm").on("input", "input, textarea", function () {
        $(this).removeClass("is-invalid is-valid");

        $("#contactFeedback")
            .removeClass("text-success text-danger")
            .text("");
    });

});
